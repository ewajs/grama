{
  "name": "grama",
  "private": true,
  "version": "0.15.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "npm run lint && npm run typecheck && vitest run",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "svelte-check --tsconfig ./tsconfig.app.json --fail-on-warnings && tsc -p tsconfig.node.json",
    "test": "vitest",
    "e2e": "playwright test",
    "audit": "npm audit --omit=dev",
    "budget": "node scripts/budget.ts",
    "docs": "typedoc",
    "words": "node scripts/prepare-words.ts",
    "icons": "node scripts/icons.ts",
    "guide": "vitepress build guide",
    "guide:dev": "vitepress dev guide",
    "guide:screenshots": "playwright test --config guide/playwright.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@msgpack/msgpack": "^3.1.3",
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^65.3.12",
    "eslint-plugin-svelte": "^3.23.1",
    "fflate": "^0.8.3",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.5",
    "workbox-window": "^7.4.1"
  },
  "dependencies": {
    "@fontsource-variable/outfit": "^5.3.0"
  },
  "license": "MIT"
}
